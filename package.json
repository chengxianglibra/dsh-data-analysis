{
  "name": "dsh-data-analysis-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @chengxianglibra/dsh-data-analysis",
    "check": "npm run quality && npm run deps:check && npm run typecheck && npm test",
    "ci": "biome ci . && npm run deps:check && npm run typecheck && npm run test:release && npm run build && npm run verify:plugin-package",
    "clean": "npm run clean --workspace @chengxianglibra/dsh-data-analysis",
    "deps:check": "npm run prepare:source && node scripts/check-dependencies.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "pack:plugin": "npm run ci && node scripts/pack-plugin.mjs",
    "quality": "biome check .",
    "quality:fix": "biome check --write .",
    "test": "node scripts/test-all.mjs",
    "test:runtime-workspace": "node scripts/test-suite.mjs runtime-workspace",
    "test:environment-execution": "node scripts/test-suite.mjs environment-execution",
    "test:help-disclosure": "node scripts/test-suite.mjs help-disclosure",
    "test:datasource-credentials": "node scripts/test-suite.mjs datasource-credentials",
    "test:plugin-integration-delivery": "node scripts/test-suite.mjs plugin-integration-delivery",
    "typecheck": "npm run typecheck:source && npm run typecheck:scripts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "typecheck:source": "npm run prepare:source && tsc -p tsconfig.json",
    "verify:plugin-package": "node scripts/verify-plugin-package.mjs",
    "validate:runtime-workspace:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-runtime-workspace-real.ts",
    "validate:environment-execution:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-environment-execution-real.ts",
    "validate:help-disclosure:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-help-disclosure-real.ts",
    "validate:datasource-configuration:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-datasource-configuration-real.ts",
    "validate:datasource-credentials:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-datasource-credentials-real.ts",
    "validate:datasource-execution:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-datasource-execution-real.ts",
    "validate:plugin-integration-delivery:real": "npm run prepare:source && node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-plugin-integration-delivery-real.ts",
    "test:semantic-reference-input": "node scripts/test-suite.mjs semantic-reference-input",
    "test:semantic-browser": "node scripts/test-suite.mjs semantic-browser",
    "validate:semantic-ask-dsh:web": "npm run prepare:source && node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-semantic-ask-dsh.ts",
    "validate:semantic-browser:web": "npm run build:ui-styles && node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-semantic-browser-web.ts",
    "validate:credentials:web": "npm run build:ui-styles && node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-credentials-web.ts",
    "test:presentation-surface": "node scripts/test-suite.mjs presentation-surface",
    "test:presentation-projection": "node scripts/test-suite.mjs presentation-projection",
    "validate:presentation-browser:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-presentation-browser-real.ts",
    "validate:report-catalog:web": "npm run prepare:source && node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-report-catalog.ts",
    "test:presentation-integration": "node scripts/test-suite.mjs presentation-integration",
    "validate:presentation-integration:real": "npm run prepare:source && node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-presentation-integration-real.ts",
    "test:presentation-skill": "node scripts/test-suite.mjs presentation-skill",
    "validate:file-analysis:real": "npm run prepare:source && node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-file-analysis-real.ts",
    "test:right-tabs": "node scripts/test-suite.mjs right-tabs",
    "validate:right-tabs:web": "npm run prepare:source && node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-right-tabs-web.ts",
    "validate:workspace-shortcuts:web": "npm run prepare:source && node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-workspace-shortcuts-web.ts",
    "validate:plugin-lifecycle:real": "npm run prepare:source && node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-plugin-lifecycle-real.ts",
    "validate:report-read-latency": "npm run prepare:source && node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-report-read-latency.ts",
    "validate:locale": "npm run build:ui-styles && node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-locale.ts",
    "test:python-tool": "node scripts/test-suite.mjs python-tool",
    "validate:python-tool:web": "npm run build:ui-styles && node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-python-tool-web.ts",
    "validate:python-settings:web": "npm run build:ui-styles && node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-python-settings-web.ts",
    "prepare:source": "node packages/dsh-data-analysis/scripts/generate-analysis-catalog.mjs --build && node packages/dsh-data-analysis/scripts/generate-skill-build.mjs",
    "generate:analysis-catalog": "node packages/dsh-data-analysis/scripts/generate-analysis-catalog.mjs",
    "test:unified-analysis-ui": "node scripts/test-suite.mjs unified-analysis-ui",
    "validate:unified-analysis-ui:runtime": "npm run prepare:source && node --experimental-strip-types packages/dsh-data-analysis/scripts/unified-analysis-ui/runtime.ts",
    "validate:unified-analysis-ui:web": "node --experimental-strip-types packages/dsh-data-analysis/scripts/unified-analysis-ui/web.ts",
    "build:ui-styles": "node packages/dsh-data-analysis/scripts/build-ui-styles.mjs",
    "check:ui-styles": "node packages/dsh-data-analysis/scripts/build-ui-styles.mjs --check",
    "validate:result-references:real": "npm run prepare:source && node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-result-references-real.ts",
    "test:validation-guards": "node --experimental-strip-types --test --test-reporter=./scripts/test-reporter.mjs packages/dsh-data-analysis/tests/plugin-integration-delivery/file-delivery-guards.validation.ts",
    "test:release": "node scripts/test-all.mjs release",
    "test:full": "node scripts/test-all.mjs full"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-group": "^1.0.5",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.3",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-authorization": "0.2.1-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.2",
    "@deepseek-ai/dsh-deepseek-account": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-hook-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-telemetry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.2",
    "@deepseek-ai/dsh-spill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-present": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-time": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workflow": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "@opentelemetry/api": "1.9.1",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "@types/semver": "^7.7.1",
    "immer": "10.1.1",
    "react": "^18.3.1",
    "semver": "^7.8.5",
    "typescript": "^6.0.3",
    "zod": "4.4.3"
  }
}
