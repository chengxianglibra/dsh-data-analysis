{
  "name": "dsh-data-analysis-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @chengxianglibra/dsh-data-analysis",
    "check": "npm run quality && npm run deps:check && npm run typecheck && npm test",
    "ci": "biome ci . && npm run deps:check && npm run typecheck && npm test && npm run build && npm run verify:plugin-package",
    "clean": "npm run clean --workspace @chengxianglibra/dsh-data-analysis",
    "deps:check": "node scripts/check-dependencies.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "pack:plugin": "npm run check && npm run verify:plugin-package && node scripts/pack-plugin.mjs",
    "quality": "biome check .",
    "quality:fix": "biome check --write .",
    "test": "npm run test:runtime-workspace && npm run test:environment-execution && npm run test:help-disclosure && npm run test:datasource-credentials && npm run test:presentation-surface && npm run test:plugin-integration-delivery && npm run test:semantic-reference-input && npm run test:semantic-browser && npm run test:presentation-s0 && npm run test:presentation-projection && npm run test:presentation-reader && npm run test:presentation-integration && npm run test:presentation-skill && npm run test:right-tabs",
    "test:presentation-s0": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/presentation-s0/*.test.ts",
    "validate:presentation-s0:runtime": "node --experimental-strip-types packages/dsh-data-analysis/scripts/presentation-s0/runtime.ts",
    "validate:presentation-s0:web": "node --experimental-strip-types packages/dsh-data-analysis/scripts/presentation-s0/web.ts",
    "test:runtime-workspace": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/runtime-workspace/*.test.ts",
    "test:environment-execution": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/environment-execution/*.test.ts",
    "test:help-disclosure": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/help-disclosure/*.test.ts",
    "test:datasource-credentials": "node packages/dsh-data-analysis/scripts/build-client.mjs && node --experimental-strip-types --test packages/dsh-data-analysis/tests/datasource-credentials/*.test.ts",
    "test:plugin-integration-delivery": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/plugin-integration-delivery/*.test.ts",
    "typecheck": "npm run typecheck:source && npm run typecheck:scripts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "typecheck:source": "tsc -p tsconfig.json",
    "verify:plugin-package": "node scripts/verify-plugin-package.mjs",
    "validate:runtime-workspace:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-runtime-workspace-real.ts",
    "validate:environment-execution:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-environment-execution-real.ts",
    "validate:help-disclosure:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-help-disclosure-real.ts",
    "validate:datasource-credentials:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-datasource-credentials-real.ts",
    "validate:datasource-execution:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-datasource-execution-real.ts",
    "validate:plugin-integration-delivery:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-plugin-integration-delivery-real.ts",
    "test:semantic-reference-input": "node packages/dsh-data-analysis/scripts/build-client.mjs && node --experimental-strip-types --test packages/dsh-data-analysis/tests/semantic-reference-input/*.test.ts",
    "test:semantic-browser": "node packages/dsh-data-analysis/scripts/build-client.mjs && node --experimental-strip-types --test packages/dsh-data-analysis/tests/semantic-browser/*.test.ts",
    "validate:semantic-browser:web": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-semantic-browser-web.ts",
    "validate:credentials:web": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-credentials-web.ts",
    "test:presentation-surface": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/presentation-surface/*.test.ts",
    "test:presentation-projection": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/presentation-projection/*.test.ts",
    "validate:presentation-projection:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-presentation-projection-real.ts",
    "validate:presentation-browser:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-presentation-browser-real.ts",
    "test:presentation-reader": "npm run build && node --experimental-strip-types --test packages/dsh-data-analysis/tests/presentation-reader/*.test.ts",
    "validate:presentation-export": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-presentation-export.ts",
    "validate:presentation-interaction": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-presentation-interaction.ts",
    "validate:presentation-semantic-navigation": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-presentation-semantic-navigation.ts",
    "validate:report-catalog:web": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-report-catalog.ts",
    "validate:presentation-ask-dsh": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-presentation-ask-dsh.ts",
    "validate:presentation-reader:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-presentation-reader-real.ts",
    "test:presentation-integration": "node packages/dsh-data-analysis/scripts/build-client.mjs && node --experimental-strip-types --test packages/dsh-data-analysis/tests/presentation-integration/*.test.ts",
    "validate:presentation-integration:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-presentation-integration-real.ts",
    "test:presentation-skill": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/presentation-skill/*.test.ts",
    "validate:presentation-agent:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-presentation-agent-real.ts",
    "test:right-tabs": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/right-tabs/*.test.ts",
    "validate:right-tabs:web": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-right-tabs-web.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-group": "^1.0.2",
    "@deepseek-ai/dsh": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-atomic-write": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-authorization": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-bash-local": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-compaction": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-fs": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-invariants": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-output-retention": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-sandbox": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-session-telemetry": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-session-title-llm": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-shell": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-spill": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-subagent-in-process-driver": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-timeout": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-workflow": "^0.1.5-alpha.1",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "typescript": "^6.0.3",
    "@deepseek-ai/dsh-settings": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-attachment": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-session-query": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-util-time": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-util-workspace-path": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-jobs": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-hook-protocol": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-sdk-protocol": "^0.1.5-alpha.1"
  }
}
