{
  "name": "dsh-data-analysis-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @chengxianglibra/dsh-data-analysis",
    "check": "npm run quality && npm run deps:check && npm run typecheck && npm test",
    "ci": "biome ci . && npm run deps:check && npm run typecheck && npm test && npm run build && npm run verify:plugin-package",
    "clean": "npm run clean --workspace @chengxianglibra/dsh-data-analysis",
    "deps:check": "node scripts/check-dependencies.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "pack:plugin": "npm run check && npm run verify:plugin-package && node scripts/pack-plugin.mjs",
    "quality": "biome check .",
    "quality:fix": "biome check --write .",
    "test": "npm run test:runtime-workspace && npm run test:environment-execution && npm run test:help-disclosure && npm run test:datasource-credentials && npm run test:presentation-surface && npm run test:plugin-integration-delivery && npm run test:semantic-reference-input && npm run test:semantic-browser && npm run test:presentation-projection && npm run test:presentation-integration && npm run test:presentation-skill && npm run test:right-tabs && npm run test:python-tool && npm run test:unified-analysis-ui",
    "test:runtime-workspace": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/runtime-workspace/*.test.ts",
    "test:environment-execution": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/environment-execution/*.test.ts",
    "test:help-disclosure": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/help-disclosure/*.test.ts",
    "test:datasource-credentials": "node packages/dsh-data-analysis/scripts/build-client.mjs && node --experimental-strip-types --test packages/dsh-data-analysis/tests/datasource-credentials/*.test.ts",
    "test:plugin-integration-delivery": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/plugin-integration-delivery/*.test.ts scripts/dependency-policy.test.mjs",
    "typecheck": "npm run typecheck:source && npm run typecheck:scripts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "typecheck:source": "tsc -p tsconfig.json",
    "verify:plugin-package": "node scripts/verify-plugin-package.mjs",
    "validate:runtime-workspace:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-runtime-workspace-real.ts",
    "validate:environment-execution:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-environment-execution-real.ts",
    "validate:help-disclosure:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-help-disclosure-real.ts",
    "validate:datasource-configuration:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-datasource-configuration-real.ts",
    "validate:datasource-configuration:web": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-datasource-configuration-web.ts",
    "validate:datasource-configuration:model": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-datasource-configuration-model.ts",
    "validate:datasource-credentials:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-datasource-credentials-real.ts",
    "validate:datasource-execution:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-datasource-execution-real.ts",
    "validate:plugin-integration-delivery:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-plugin-integration-delivery-real.ts",
    "test:semantic-reference-input": "node packages/dsh-data-analysis/scripts/build-client.mjs && node --experimental-strip-types --test packages/dsh-data-analysis/tests/semantic-reference-input/*.test.ts",
    "test:semantic-browser": "node packages/dsh-data-analysis/scripts/build-client.mjs && node --experimental-strip-types --test packages/dsh-data-analysis/tests/semantic-browser/*.test.ts",
    "validate:semantic-ask-dsh:web": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-semantic-ask-dsh.ts",
    "validate:semantic-browser:web": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-semantic-browser-web.ts",
    "validate:credentials:web": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-credentials-web.ts",
    "test:presentation-surface": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/presentation-surface/*.test.ts",
    "test:presentation-projection": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/presentation-projection/*.test.ts",
    "validate:presentation-browser:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-presentation-browser-real.ts",
    "validate:presentation-semantic-navigation": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-presentation-semantic-navigation.ts",
    "validate:report-catalog:web": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-report-catalog.ts",
    "test:presentation-integration": "node packages/dsh-data-analysis/scripts/build-client.mjs && node --experimental-strip-types --test packages/dsh-data-analysis/tests/presentation-integration/*.test.ts",
    "validate:presentation-integration:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-presentation-integration-real.ts",
    "test:presentation-skill": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/presentation-skill/*.test.ts",
    "validate:file-analysis:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-file-analysis-real.ts",
    "test:right-tabs": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/right-tabs/*.test.ts",
    "validate:right-tabs:web": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-right-tabs-web.ts",
    "validate:workspace-shortcuts:web": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-workspace-shortcuts-web.ts",
    "validate:plugin-lifecycle:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-plugin-lifecycle-real.ts",
    "validate:datasource-removal:web": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-datasource-removal-web.ts",
    "validate:report-read-latency": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-report-read-latency.ts",
    "validate:locale": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-locale.ts",
    "test:python-tool": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/python-tool/*.test.ts",
    "validate:python-tool:web": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-python-tool-web.ts",
    "validate:python-settings:web": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-python-settings-web.ts",
    "generate:analysis-catalog": "node packages/dsh-data-analysis/scripts/generate-analysis-catalog.mjs",
    "test:unified-analysis-ui": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/unified-analysis-ui/*.test.ts",
    "validate:unified-analysis-ui:p1": "node --experimental-strip-types packages/dsh-data-analysis/scripts/unified-analysis-ui/runtime-p1.ts",
    "validate:unified-analysis-ui:runtime": "node --experimental-strip-types packages/dsh-data-analysis/scripts/unified-analysis-ui/runtime.ts",
    "validate:unified-analysis-ui:web": "node --experimental-strip-types packages/dsh-data-analysis/scripts/unified-analysis-ui/web.ts",
    "validate:unified-analysis-ui:p2": "node --experimental-strip-types packages/dsh-data-analysis/scripts/unified-analysis-ui/runtime-p1.ts --p2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-group": "^1.0.5",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.3",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-authorization": "0.2.1-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.2",
    "@deepseek-ai/dsh-deepseek-account": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-hook-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-telemetry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.2",
    "@deepseek-ai/dsh-spill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-present": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-time": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workflow": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "@opentelemetry/api": "1.9.1",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "@types/semver": "^7.7.1",
    "immer": "10.1.1",
    "react": "^18.3.1",
    "semver": "^7.8.5",
    "typescript": "^6.0.3",
    "zod": "4.4.3"
  }
}
