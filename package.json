{
  "name": "dsh-data-analysis-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @deepseek-ai/dsh-data-analysis",
    "check": "npm run quality && npm run deps:check && npm run typecheck && npm test",
    "ci": "biome ci . && npm run deps:check && npm run typecheck && npm test && npm run build && npm run verify:plugin-package",
    "clean": "npm run clean --workspace @deepseek-ai/dsh-data-analysis",
    "deps:check": "node scripts/check-dependencies.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "pack:plugin": "npm run check && npm run verify:plugin-package && node scripts/pack-plugin.mjs",
    "quality": "biome check .",
    "quality:fix": "biome check --write .",
    "test": "npm run test:runtime-workspace && npm run test:environment-execution && npm run test:help-disclosure && npm run test:datasource-credentials && npm run test:evidence-sources && npm run test:agent-native-report-primitives && npm run test:report-check && npm run test:report-disclosure && npm run test:plugin-integration-delivery",
    "test:runtime-workspace": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/runtime-workspace/*.test.ts",
    "test:environment-execution": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/environment-execution/*.test.ts",
    "test:help-disclosure": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/help-disclosure/*.test.ts",
    "test:datasource-credentials": "node packages/dsh-data-analysis/scripts/build-client.mjs && node --experimental-strip-types --test packages/dsh-data-analysis/tests/datasource-credentials/*.test.ts",
    "test:evidence-sources": "node packages/dsh-data-analysis/scripts/build-client.mjs && node --experimental-strip-types --test packages/dsh-data-analysis/tests/evidence-sources/*.test.ts",
    "test:agent-native-report-primitives": "node packages/dsh-data-analysis/scripts/build-client.mjs && node --experimental-strip-types --test packages/dsh-data-analysis/tests/agent-native-report-primitives/*.test.ts",
    "test:plugin-integration-delivery": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/plugin-integration-delivery/*.test.ts",
    "test:report-check": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/report-check/*.test.ts",
    "test:report-disclosure": "node --experimental-strip-types --test packages/dsh-data-analysis/tests/report-disclosure/*.test.ts",
    "typecheck": "npm run typecheck:source && npm run typecheck:scripts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "typecheck:source": "tsc -p tsconfig.json",
    "verify:plugin-package": "node scripts/verify-plugin-package.mjs",
    "validate:runtime-workspace:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-runtime-workspace-real.ts",
    "validate:environment-execution:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-environment-execution-real.ts",
    "validate:help-disclosure:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-help-disclosure-real.ts",
    "validate:datasource-credentials:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-datasource-credentials-real.ts",
    "validate:evidence-sources:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-evidence-sources-real.ts",
    "validate:agent-native-report-primitives:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-agent-native-report-primitives-real.ts",
    "validate:plugin-integration-delivery:real": "node --experimental-strip-types packages/dsh-data-analysis/scripts/validate-plugin-integration-delivery-real.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-group": "^1.0.1",
    "@deepseek-ai/dsh": "latest",
    "@deepseek-ai/dsh-atomic-write": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-authorization": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-bash-local": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-output-retention": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-telemetry": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-shell": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-spill": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent-in-process-driver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-workflow": "^0.1.1-rc.2",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "typescript": "^6.0.3"
  }
}
