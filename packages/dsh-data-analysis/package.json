    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-bash": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-present": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "@tailwindcss/node": "4.3.4",
    "@tailwindcss/oxide": "4.3.4",
    "@tanstack/react-virtual": "3.14.10",
    "@types/react": "^18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "^0.28.2",
    "immer": "10.1.1",
    "playwright": "1.63.0",
    "postcss": "8.5.8",
    "postcss-selector-parser": "7.1.1",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "^6.0.3",
    "zustand": "4.5.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
