{
  "name": "@chengxianglibra/dsh-data-analysis",
  "description": "Marivo runtime, live Help, secure datasource execution and presentation delivery for DeepSeek Harness",
  "version": "0.2.4-dev.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengxianglibra/dsh-data-analysis.git",
    "directory": "packages/dsh-data-analysis"
  },
  "homepage": "https://github.com/chengxianglibra/dsh-data-analysis#readme",
  "bugs": {
    "url": "https://github.com/chengxianglibra/dsh-data-analysis/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-data-analysis-env": "./lib/bin/environment.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./client-composition": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client-composition.js"
    },
    "./integration": {
      "types": "./lib/types/integration.d.ts",
      "default": "./lib/integration.js"
    },
    "./environment": {
      "types": "./lib/types/environment/index.d.ts",
      "default": "./lib/environment/index.js"
    },
    "./disclosure": {
      "types": "./lib/types/disclosure/index.d.ts",
      "default": "./lib/disclosure/index.js"
    },
    "./datasource": {
      "types": "./lib/types/datasource/index.d.ts",
      "default": "./lib/datasource/index.js"
    },
    "./compatibility": {
      "types": "./lib/types/compatibility.d.ts",
      "default": "./lib/compatibility.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "skills/dsh-data-analysis-presentation/**",
    "skills/dsh-data-analysis-files/**",
    "python/presentation-kit/dist/dsh_data_analysis_presentation_kit-1.5.1-py3-none-any.whl",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "npm run clean && node scripts/generate-analysis-catalog.mjs --build && tsc -p tsconfig.build.json && node scripts/finalize-build.mjs",
    "clean": "node scripts/clean.mjs",
    "prepack": "npm run build:presentation-kit && npm run build",
    "build:presentation-kit": "node scripts/build-presentation-kit.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dshDataAnalysisCompatibility": {
    "schema": "dsh-data-analysis-compatibility/v2",
    "dsh": {
      "distribution": "@deepseek-ai/dsh",
      "peerRange": ">=0.2.1-rc.2"
    },
    "marivo": {
      "version": "0.6.0",
      "packageSpec": "marivo[duckdb,trino,clickhouse]==0.6.0"
    },
    "contracts": {
      "runtimeInstallation": "dsh-data-analysis-runtime/v3",
      "subprocessPolicy": "direct-argv-inherited-env-snapshot-overlay-v2",
      "integration": "dsh-data-analysis-integration/v1"
    }
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@noble/hashes": "2.4.0",
    "@openuidev/lang-core": "1.0.1",
    "@openuidev/react-headless": "0.18.1",
    "@openuidev/react-lang": "1.0.1",
    "@openuidev/react-ui": "0.18.1",
