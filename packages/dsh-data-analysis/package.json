{
  "name": "@chengxianglibra/dsh-data-analysis",
  "description": "Marivo runtime, live Help, secure datasource execution and presentation delivery for DeepSeek Harness",
  "version": "0.1.3-dev.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengxianglibra/dsh-data-analysis.git",
    "directory": "packages/dsh-data-analysis"
  },
  "homepage": "https://github.com/chengxianglibra/dsh-data-analysis#readme",
  "bugs": {
    "url": "https://github.com/chengxianglibra/dsh-data-analysis/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-data-analysis-env": "./lib/bin/environment.js",
    "dsh-data-analysis-presentation-lint": "./lib/bin/presentation-lint.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./environment": {
      "types": "./lib/types/environment/index.d.ts",
      "default": "./lib/environment/index.js"
    },
    "./disclosure": {
      "types": "./lib/types/disclosure/index.d.ts",
      "default": "./lib/disclosure/index.js"
    },
    "./datasource": {
      "types": "./lib/types/datasource/index.d.ts",
      "default": "./lib/datasource/index.js"
    },
    "./compatibility": {
      "types": "./lib/types/compatibility.d.ts",
      "default": "./lib/compatibility.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "skills/dsh-data-analysis-presentation/**",
    "python/presentation-kit/dist/dsh_data_analysis_presentation_kit-1.1.0-py3-none-any.whl",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/finalize-build.mjs",
    "clean": "node scripts/clean.mjs",
    "prepack": "npm run build:presentation-kit && npm run build",
    "build:presentation-kit": "node scripts/build-presentation-kit.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dshDataAnalysisCompatibility": {
    "schema": "dsh-data-analysis-compatibility/v2",
    "dsh": {
      "distribution": "@deepseek-ai/dsh",
      "peerRange": "^0.1.5-alpha.1"
    },
    "marivo": {
      "version": "0.5.4",
      "packageSpec": "marivo[duckdb,trino,clickhouse]==0.5.4"
    },
    "contracts": {
      "runtimeInstallation": "dsh-data-analysis-runtime/v3",
      "subprocessPolicy": "direct-argv-inherited-env-snapshot-overlay-v2"
    }
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-loop": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-anonymous-user-id": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-bash-local": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-code-runtime": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-credentials-local": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-fs-local": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-fs-observation-policy": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-llm-deepseek": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-scope": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-skill": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-subprocess-local": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-tool-bash": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-tool-fs": "^0.1.5-alpha.1",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "typescript": "^6.0.3",
    "esbuild": "^0.28.2",
    "@deepseek-ai/dsh-storage": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-storage-json": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.5-alpha.1",
    "@types/react-dom": "18.3.7",
    "playwright": "1.63.0",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "recharts": "3.8.1",
    "@deepseek-ai/dsh-launch-environment": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-tool-skill": "^0.1.5-alpha.1",
    "@shikijs/core": "4.4.3",
    "@shikijs/engine-javascript": "4.4.3",
    "@shikijs/langs": "4.4.3",
    "@wasm-fmt/ruff_fmt": "0.15.20",
    "sql-formatter": "15.8.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.5-alpha.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-tool": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-credentials": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-shell-env": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-scope": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-alpha.1",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-alpha.1",
    "react": "^18.3.1",
    "@deepseek-ai/dsh-storage-domain": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-input-trigger": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-workspace": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-shell": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-sandbox": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-atomic-write": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-chat": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-util-values": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.1.5-alpha.1"
  }
}
