{
  "name": "@deepseek-ai/dsh-data-analysis",
  "description": "Marivo runtime, live-help, datasource, and on-demand Evidence source integration for DeepSeek Harness",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-data-analysis-env": "./lib/bin/environment.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./environment": {
      "types": "./lib/types/environment/index.d.ts",
      "default": "./lib/environment/index.js"
    },
    "./disclosure": {
      "types": "./lib/types/disclosure/index.d.ts",
      "default": "./lib/disclosure/index.js"
    },
    "./datasource": {
      "types": "./lib/types/datasource/index.d.ts",
      "default": "./lib/datasource/index.js"
    },
    "./evidence": {
      "types": "./lib/types/evidence/index.d.ts",
      "default": "./lib/evidence/index.js"
    },
    "./compatibility": {
      "types": "./lib/types/compatibility.d.ts",
      "default": "./lib/compatibility.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/types/**/*.d.ts",
    "skills/**/*.md",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/finalize-build.mjs",
    "clean": "node scripts/clean.mjs",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dshDataAnalysisCompatibility": {
    "schema": "dsh-data-analysis-compatibility/v1",
    "dsh": {
      "distribution": "@deepseek-ai/dsh",
      "peerRange": "0.1.1-rc.2"
    },
    "marivo": {
      "version": "0.5.1",
      "packageSpec": "marivo[duckdb,trino,clickhouse]==0.5.1"
    },
    "contracts": {
      "runtimeInstallation": "dsh-data-analysis-runtime/v1",
      "subprocessPolicy": "direct-argv-inherited-env-snapshot-overlay-v1"
    }
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-loop": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-anonymous-user-id": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-bash-local": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-code-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials-local": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-fs-local": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-fs-observation-policy": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-bash": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-fs": "^0.1.1-rc.2",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-shell-env": "0.1.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "react": "^18.3.1"
  }
}
