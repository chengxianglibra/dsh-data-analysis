{
  "schema": "dsh-data-analysis-report-check-rules/v1",
  "rules": [
    { "code": "html.parse-error", "severity": "error", "group": "html" },
    { "code": "html.doctype-missing", "severity": "error", "group": "html" },
    { "code": "html.lang-missing", "severity": "error", "group": "html" },
    { "code": "html.title-invalid", "severity": "error", "group": "html" },
    { "code": "html.viewport-missing", "severity": "error", "group": "html" },
    { "code": "html.main-invalid", "severity": "error", "group": "html" },
    { "code": "html.duplicate-id", "severity": "error", "group": "html" },
    { "code": "html.fragment-target-missing", "severity": "error", "group": "html" },
    { "code": "html.aria-reference-missing", "severity": "error", "group": "html" },
    { "code": "html.element-attributes-invalid", "severity": "error", "group": "html" },
    { "code": "html.dangerous-url-scheme", "severity": "error", "group": "html" },
    { "code": "html.base-element-forbidden", "severity": "error", "group": "html" },
    { "code": "resource.missing", "severity": "error", "group": "resource" },
    { "code": "resource.not-regular-file", "severity": "error", "group": "resource" },
    { "code": "resource.type-unsupported", "severity": "error", "group": "resource" },
    { "code": "resource.outside-bundle", "severity": "error", "group": "resource" },
    { "code": "resource.file-url-forbidden", "severity": "error", "group": "resource" },
    { "code": "resource.data-url-kind-forbidden", "severity": "error", "group": "resource" },
    {
      "code": "resource.external-dependency-unchecked",
      "severity": "warning",
      "group": "resource"
    },
    { "code": "resource.external-navigation-unchecked", "severity": "info", "group": "resource" },
    { "code": "resource.external-action-unchecked", "severity": "info", "group": "resource" },
    { "code": "resource.dynamic-network-unchecked", "severity": "info", "group": "resource" },
    { "code": "css.parse-error", "severity": "error", "group": "css" },
    { "code": "javascript.parse-error", "severity": "error", "group": "javascript" },
    { "code": "json.parse-error", "severity": "error", "group": "json" },
    { "code": "svg.parse-error", "severity": "error", "group": "svg" },
    { "code": "dataset.registry-order-invalid", "severity": "error", "group": "dataset" },
    { "code": "dataset.duplicate-id", "severity": "error", "group": "dataset" },
    { "code": "dataset.unregistered-read", "severity": "error", "group": "dataset" },
    { "code": "dataset.schema-invalid", "severity": "error", "group": "dataset" },
    { "code": "trace.registry-order-invalid", "severity": "error", "group": "trace" },
    { "code": "trace.duplicate-id", "severity": "error", "group": "trace" },
    { "code": "trace.unregistered-read", "severity": "error", "group": "trace" },
    { "code": "trace.schema-invalid", "severity": "error", "group": "trace" },
    { "code": "trace.identity-dangling", "severity": "error", "group": "trace" },
    { "code": "trace.artifact-preview-missing", "severity": "error", "group": "trace" },
    { "code": "trace.missing-for-artifact-report", "severity": "warning", "group": "trace" },
    { "code": "a11y.image-alt-invalid", "severity": "error", "group": "a11y" },
    { "code": "a11y.control-name-missing", "severity": "error", "group": "a11y" },
    { "code": "a11y.table-caption-missing", "severity": "warning", "group": "a11y" },
    { "code": "a11y.table-header-missing", "severity": "error", "group": "a11y" },
    { "code": "a11y.table-header-association-uncertain", "severity": "warning", "group": "a11y" },
    { "code": "a11y.svg-name-missing", "severity": "error", "group": "a11y" },
    { "code": "a11y.heading-order-invalid", "severity": "error", "group": "a11y" },
    { "code": "a11y.h1-invalid", "severity": "error", "group": "a11y" },
    { "code": "a11y.positive-tabindex", "severity": "error", "group": "a11y" },
    { "code": "a11y.autoplay-enabled", "severity": "error", "group": "a11y" },
    { "code": "a11y.hover-only-content", "severity": "error", "group": "a11y" },
    { "code": "a11y.color-only-state", "severity": "error", "group": "a11y" },
    { "code": "a11y.focus-style-missing", "severity": "warning", "group": "a11y" },
    { "code": "a11y.reduced-motion-missing", "severity": "warning", "group": "a11y" },
    { "code": "security.secret-like-name", "severity": "warning", "group": "security" },
    { "code": "starter.placeholder-unresolved", "severity": "error", "group": "starter" },
    { "code": "budget.file-count-exceeded", "severity": "error", "group": "budget" },
    { "code": "budget.graph-depth-exceeded", "severity": "error", "group": "budget" },
    { "code": "budget.text-file-bytes-exceeded", "severity": "error", "group": "budget" },
    { "code": "budget.total-text-bytes-exceeded", "severity": "error", "group": "budget" },
    { "code": "budget.data-url-bytes-exceeded", "severity": "error", "group": "budget" },
    { "code": "budget.issue-count-truncated", "severity": "info", "group": "budget" }
  ]
}
